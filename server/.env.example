# Copy to .env for local development: cp .env.example .env
DATABASE_URL=postgres://sharp:sharp@localhost:5432/sharp
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me

# Optional passkeys/WebAuthn. RP_ID must remain stable after enrollment.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGINS=
WEBAUTHN_RP_NAME=Sharp
PORT=3000
SHARP_DISABLE_SIGNUP=false
RUST_LOG=info
# WEB_DIST=../web/dist

# Public base URL of the web app, used for links in outgoing emails. Falls back
# to the request Origin/Host when unset — set it explicitly in a split deploy
# where the SPA lives on a different host than the API.
# APP_URL=http://localhost:5173

# --- File uploads (S3-compatible: AWS S3, MinIO, Cloudflare R2, Backblaze B2) ---
# Uploads are enabled only when BUCKET + ACCESS_KEY + SECRET_KEY are all set.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=sharp
S3_ACCESS_KEY=sharp
S3_SECRET_KEY=sharp-secret
S3_REGION=us-east-1
# Allow plaintext http (auto-on when S3_ENDPOINT starts with http://; set for MinIO):
S3_ALLOW_HTTP=true
# Max upload size in MB (default 25):
# MAX_UPLOAD_MB=25

# --- Voice/video calls (LiveKit SFU) ---
# All four must be set together or all four left unset — a partial set is a
# startup error. Unset means calls are disabled. LIVEKIT_URL is the browser-facing
# URL; LIVEKIT_INTERNAL_URL is how the server reaches LiveKit's HTTP API.
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_INTERNAL_URL=http://localhost:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret

# --- Web push (VAPID) ---
# Leave unset to auto-generate + persist a keypair on first startup (recommended
# for self-hosting). To pin your own, generate with `npx web-push generate-vapid-keys`
# and set both (VAPID_PRIVATE_KEY is the raw base64url private key, not a PEM):
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@sharp.app

# --- Native macOS push (APNs, Tauri desktop app) ---
# Inert unless team id + key id + private key + bundle id are all set. Requires a
# paid Apple Developer account and only works in a signed/notarized build with the
# `aps-environment` entitlement; unsigned builds fall back to WS + web push.
# Give the .p8 contents inline via APNS_PRIVATE_KEY, or point at the file with
# APNS_PRIVATE_KEY_PATH. APNS_ENV must be exactly `production` for the prod host;
# anything else (including unset) targets the sandbox.
# APNS_TEAM_ID=
# APNS_KEY_ID=
# APNS_PRIVATE_KEY=
# APNS_PRIVATE_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8
# APNS_BUNDLE_ID=dev.sharp.app
# APNS_ENV=production

# Optional access token for the Expo push service (mobile). Sent as a bearer
# token when present; pushes still work unauthenticated without it.
# EXPO_ACCESS_TOKEN=

# --- Password-reset email ---
# The reset flow is inert and the "Forgot password?" link hidden unless EMAIL_FROM
# is set alongside one backend below. Resend wins when both are configured.
# EMAIL_FROM=Sharp <noreply@sharp.app>

# Backend 1 — Resend HTTP API (preferred: needs no outbound SMTP ports, which many
# hosts block). EMAIL_FROM's domain must be verified in Resend or sends are
# rejected. RESEND_BASE_URL is only for pointing at a mock in tests.
# RESEND_API_KEY=re_...
# RESEND_BASE_URL=https://api.resend.com

# Backend 2 — any SMTP relay, used only when RESEND_API_KEY is empty. SMTP_PORT
# defaults to 465; TLS is implicit on 465 and STARTTLS otherwise, overridable with
# SMTP_TLS=implicit|starttls. SMTP_FROM is still accepted as an EMAIL_FROM alias.
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_TLS=

# --- Sharpy AI assistant (OpenAI-compatible chat + embeddings) ---
# Disabled entirely unless AI_API_KEY is set. Works with OpenAI, DeepSeek, Ollama,
# etc. The provider needs an /embeddings endpoint for retrieval; chat-only
# providers degrade to context-free answers. Changing AI_EMBED_MODEL after any
# content is indexed requires truncating the embedding tables (the vector columns
# are dimension-less, so mixed dimensions break the cosine scan).
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_CHAT_MODEL=gpt-4o-mini
# AI_EMBED_MODEL=text-embedding-3-small

# --- Live call transcription ---
# Each setting falls back to its AI_* counterpart, so transcription works with no
# extra config when the AI provider also serves audio. Set these only to point
# transcription at a different provider (for example OpenAI or Groq for audio
# while chat runs on DeepSeek).
# TRANSCRIBE_API_KEY=
# TRANSCRIBE_BASE_URL=
# TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# GIPHY API key used by GIF search when no workspace key is saved (default provider).
# GIPHY_API_KEY=
# Tenor v2 API key for legacy clients; Tenor no longer accepts new API clients.
# TENOR_API_KEY=
# DeepSeek API key used by automatic GIF suggestions.
# DEEPSEEK_API_KEY=
# DeepSeek chat model (default: deepseek-chat).
# DEEPSEEK_MODEL=deepseek-chat
# DeepSeek API base URL (default: https://api.deepseek.com).
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Google Calendar sync (Phase 5) ---
# Calendar sync is disabled unless client id + secret + redirect URI are all set.
# GOOGLE_REDIRECT_URI must exactly match a redirect registered on the OAuth client
# and point at the API host: https://<api-host>/api/v1/calendar/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
