# sharp configuration — the canonical list of every variable the server reads.
#
#   cp .env.example .env   # then edit
#
# This file is the authority. `server/src/config.rs` reads exactly these names and
# nothing else; the compose files pass them through. **When you add an env var to
# config.rs, add it here in the same commit** — the compose files reference this file
# rather than restating the list, so this is the only place that has to be kept in step.
#
# The core rule: **every optional integration is inert, not broken, when unset.** An
# unconfigured feature disappears from the UI and the server starts normally. Each
# section below says what goes inert. Only DATABASE_URL and JWT_SECRET are required.
#
# Grouped keys are all-or-nothing where noted: setting some but not all of a group is a
# hard startup error, on purpose, because a half-configured integration fails later and
# further away.

# ── Required ─────────────────────────────────────────────────────────────────────────

# Postgres connection string. The compose files build this from POSTGRES_PASSWORD; set
# it directly only when pointing at an external database.
# DATABASE_URL=postgres://sharp:sharp@postgres:5432/sharp

# Postgres password for the `sharp` user (used by the bundled postgres container).
POSTGRES_PASSWORD=change-me-strong

# JWT signing secret (HS256, 30-day tokens). Changing it logs everyone out.
#   openssl rand -base64 48
JWT_SECRET=change-me-64-random-chars

# ── Server basics ────────────────────────────────────────────────────────────────────

# Listen port. Default 3000.
# PORT=3000

# Redis for multi-replica WebSocket fanout and presence. Unset = single-replica
# in-process fanout, which is correct for one container.
# REDIS_URL=redis://redis:6379

# Directory holding the built SPA. Unset/missing directory = API-only mode (used by the
# split deploy, where nginx serves the web app).
# WEB_DIST=./web-dist

# Public base URL of the web app, used to build links in outbound email. Unset = derived
# from the request's Origin/Host, which is right for a single-domain deploy.
# APP_URL=https://chat.example.com

# Close public registration. The **first** user can always register regardless — an
# instance with no accounts is unusable otherwise.
SHARP_DISABLE_SIGNUP=false

# Max upload size in MB. Default 25.
# MAX_UPLOAD_MB=25

# Log verbosity (error|warn|info|debug|trace), or a full RUST_LOG filter.
RUST_LOG=info

# ── Domains & TLS (compose/Caddy only — not read by the server) ───────────────────────

# Where the chat app is served; Caddy reverse-proxies it to sharp:3000.
SHARP_DOMAIN=chat.example.com
# Where the static landing page is served.
LANDING_DOMAIN=example.com
# Let's Encrypt / ACME registration address.
ACME_EMAIL=you@example.com

# ── File uploads (S3-compatible) ─────────────────────────────────────────────────────
#
# Inert without all three of BUCKET/ACCESS_KEY/SECRET_KEY: uploads are rejected with a
# clear error and the attach button is hidden. Works with MinIO, R2, B2, Spaces.

# S3_BUCKET=sharp
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# Custom endpoint for non-AWS providers. Unset = AWS.
# S3_ENDPOINT=http://minio:9000
# S3_REGION=us-east-1
# Allow plain HTTP to the endpoint. Defaults to true when S3_ENDPOINT starts http://.
# S3_ALLOW_HTTP=false

# ── Voice / video (LiveKit SFU) ──────────────────────────────────────────────────────
#
# All four together, or none: a partial group is a startup error. None = calls disabled
# and the call UI hidden. LIVEKIT_URL is what browsers connect to; LIVEKIT_INTERNAL_URL
# is how this server reaches LiveKit's API (inside the compose network).

MEDIA_DOMAIN=media.example.com
# LIVEKIT_URL=wss://media.example.com
# LIVEKIT_INTERNAL_URL=http://livekit:7880
LIVEKIT_API_KEY=sharp-livekit
LIVEKIT_API_SECRET=change-me-livekit-64-random-chars
# TURN/TLS certificate for MEDIA_DOMAIN, as host paths. Port 5349 because Caddy owns
# 443. Renew before expiry, then restart the livekit container to reload them.
LIVEKIT_TURN_CERT_FILE=/etc/letsencrypt/live/media.example.com/fullchain.pem
LIVEKIT_TURN_KEY_FILE=/etc/letsencrypt/live/media.example.com/privkey.pem

# tldraw commercial license — removes the canvas watermark. Inlined into the public web
# bundle at build time, so not a secret. Compose already defaults it; set only to rotate.
TLDRAW_LICENSE_KEY=

# ── Web push (VAPID) ─────────────────────────────────────────────────────────────────
#
# Zero-config: when these are unset the server generates a keypair on first start and
# persists it, so push works out of the box. Set them only to reuse an existing pair
# (rotating them invalidates every existing subscription).

# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# `sub` claim on VAPID JWTs — a mailto: or https: URL. Default mailto:admin@sharp.app.
# VAPID_SUBJECT=mailto:you@example.com

# ── Native macOS push (APNs) ─────────────────────────────────────────────────────────
#
# All four together or inert. Only reaches a signed + notarized desktop build with the
# aps-environment entitlement; unsigned builds silently fall back to web push.

# APNS_TEAM_ID=
# APNS_KEY_ID=
# The .p8 contents inline, or a path to the file — one of the two.
# APNS_PRIVATE_KEY=
# APNS_PRIVATE_KEY_PATH=/run/secrets/apns.p8
# APNS_BUNDLE_ID=dev.sharp.app
# `production` targets api.push.apple.com; anything else uses the sandbox host.
# APNS_ENV=production

# ── Expo push (native mobile app only) ───────────────────────────────────────────────
#
# Read directly by server/src/expo_push.rs, not by config.rs. Optional: Expo accepts
# unauthenticated sends, so this only raises rate limits. Irrelevant unless the Expo app
# in `mobile/` is in use.

# EXPO_ACCESS_TOKEN=

# ── Transactional email (password reset) ─────────────────────────────────────────────
#
# Needs EMAIL_FROM plus one backend. Without it the reset flow is inert and the
# "Forgot password?" link is hidden — there is no admin reset path, so passwords are
# then unrecoverable by design.
#
# Resend wins when both backends are configured: no outbound SMTP ports, which hosts
# commonly block. Resend rejects sends from an unverified EMAIL_FROM domain.

# EMAIL_FROM=Sharp <no-reply@example.com>
# RESEND_API_KEY=
# RESEND_BASE_URL=https://api.resend.com
#
# SMTP alternative. Port defaults to 465 (implicit TLS); STARTTLS is selected by
# SMTP_TLS=starttls or by any non-465 port.
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_TLS=implicit
# Legacy alias for EMAIL_FROM, still accepted so existing deploys keep working. Prefer
# EMAIL_FROM, which is backend-neutral.
# SMTP_FROM=

# ── Passkeys (WebAuthn) ──────────────────────────────────────────────────────────────
#
# RP_ID and ORIGINS together or neither (a partial group is a startup error); unset =
# passkeys hidden. **Keep RP_ID stable after the first enrollment** — changing it
# invalidates every registered passkey. Same-origin deploys use SHARP_DOMAIN as RP_ID
# and https://SHARP_DOMAIN as the origin; split deploys list exact origins, comma-separated.

WEBAUTHN_RP_ID=
WEBAUTHN_ORIGINS=
WEBAUTHN_RP_NAME=Sharp

# ── Sharpy AI assistant ──────────────────────────────────────────────────────────────
#
# Inert without AI_API_KEY: no assistant, no semantic search, no embedding worker. Any
# OpenAI-compatible provider works (OpenAI, DeepSeek, Ollama at http://host:11434/v1,
# LM Studio). A chat-only provider is fine — a failed query embed degrades to a
# context-free answer rather than an error.
#
# Note: switching AI_EMBED_MODEL means truncating the embedding tables, because the
# vector columns are dimension-less and mixing dimensions makes the cosine scan wrong.

AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_CHAT_MODEL=gpt-4o-mini
AI_EMBED_MODEL=text-embedding-3-small

# ── Call transcription ───────────────────────────────────────────────────────────────
#
# Each setting falls back to its AI_* counterpart, so a single provider needs nothing
# here. Set these to transcribe with a different provider than chat. Inert when neither
# TRANSCRIBE_API_KEY nor AI_API_KEY is set.

# TRANSCRIBE_API_KEY=
# TRANSCRIBE_BASE_URL=
# TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# ── GIFs and the duck roast ──────────────────────────────────────────────────────────
#
# Workspace settings persisted in the database take precedence over these; env is the
# bootstrap. No key = GIF picker hidden. GIPHY is the default provider (self-enforced
# 100 searches/hour); Tenor is legacy.
#
# DEEPSEEK_API_KEY drives the automatic "duck" roast suggestions. Without it the GIF
# picker still works, but nothing auto-suggests.

# GIPHY_API_KEY=
# TENOR_API_KEY=
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# ── Google Calendar sync ─────────────────────────────────────────────────────────────
#
# All three together or inert (id + secret without a redirect URI is a startup error —
# Google demands an exact match, so there is no safe default). Unset = sharp-native
# meetings only, no external calendar.

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://chat.example.com/api/v1/calendar/google/callback

# ── GitHub task sync ─────────────────────────────────────────────────────────────────
#
# Optional. Repositories are normally linked per project in the app (Tasks -> project ->
# GitHub), which generates its own webhook secret — no env var, no restart. These two are
# the older global fallback: one shared secret for every repository, matching identifiers
# across every project key. Links branches and PRs to tasks by identifier (SHARP-123)
# found in the branch name, title or body, and advances workflow state.

# GITHUB_WEBHOOK_SECRET=
# `owner/name` allowlist, comma-separated. Empty = accept any repo that signs correctly.
# GITHUB_REPOS=
