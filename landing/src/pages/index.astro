---
import "@fontsource-variable/inter";
import "../styles/global.css";
import {
  GITHUB_OWNER,
  docsUrl as docs,
  origin,
  releases,
  repo,
  updated,
  updatedLabel,
  version,
} from "../site";

/* Canonical origin comes from `site` in astro.config.mjs — one place to edit. */
const siteUrl = origin(Astro.site);
/* Canonical + og:url keep the trailing slash so they match the sitemap entry. */
const canonical = `${siteUrl}/`;
const ogImage = `${siteUrl}/og.png`;

/* Title ≤ 60 chars, description ≈ 155 — both fully visible in the SERP. */
const title = "sharp — open-source self-hosted Slack alternative";
const description =
  "sharp is an open-source, self-hosted Slack alternative: chat, docs, canvas, boards, video calls, tasks and an AI assistant in one container.";

/* One source of truth for the feature grid — also feeds schema.org featureList. */
const features = [
  {
    icon: "#",
    title: "Chat, threads & DMs",
    points: [
      "Public channels, private groups & direct messages",
      "One-level threads, reactions, @mentions, presence",
      "Disappearing messages with a per-channel TTL",
      "GIF picker, voice messages, @/# autocomplete",
    ],
  },
  {
    icon: "¶",
    title: "Collaborative docs",
    points: [
      "Block-based docs living inside any channel",
      "Real-time co-editing over Yjs with live cursors",
      "Owner / editor / viewer roles per doc",
      "<code>[[doc]]</code> chips bridge chat and docs",
    ],
  },
  {
    icon: "◈",
    title: "Canvas & boards",
    points: [
      "Infinite tldraw whiteboards, self-hosted assets",
      "Notion-style kanban boards as a doc kind",
      "Same permissions and inbox as docs",
      "One click from any channel",
    ],
  },
  {
    icon: "◉",
    title: "Voice, video & screen share",
    points: [
      "LiveKit SFU calls in any channel, DM or standalone room",
      "Up to 25 participants, 16 cameras, 1 screen share",
      "Picture-in-picture keeps the call floating",
      "Guest links — join by name, no account",
    ],
  },
  {
    icon: "✦",
    title: "Sharpy, the AI assistant",
    points: [
      "RAG answers grounded in your own workspace",
      "Every retrieval re-checks channel and doc permissions",
      "Any OpenAI-compatible endpoint, including local models",
      "No API key set? The whole feature disappears",
    ],
  },
  {
    icon: "◪",
    title: "Tasks & projects",
    points: [
      "Linear-lite tracker with <code>SHARP-123</code> identifiers",
      "List and board views, keyboard-first peek panel",
      "Create a task straight from a chat message",
      "GitHub branches and PRs move state automatically",
    ],
  },
  {
    icon: "▦",
    title: "Calendar & meetings",
    points: [
      "Workspace calendar with scheduled meetings",
      "Two-way Google Calendar sync (opt-in)",
      "Meetings open straight into a call room",
      "Live transcription and meeting notes",
    ],
  },
  {
    icon: "◍",
    title: "Polls & decisions",
    points: [
      "Polls in channels, sticky to the top while open",
      "In-call poll overlay for live votes",
      "Results broadcast in real time",
      "Everyone gets a <code>poll_ended</code> notification",
    ],
  },
  {
    icon: "⌕",
    title: "Files & search",
    points: [
      "Drag-and-drop uploads, images inline",
      "Instant Postgres full-text search across channels",
      "Files on your own S3 or MinIO bucket",
      "Quick switcher jumps to channels, docs and tasks",
    ],
  },
  {
    icon: "◔",
    title: "Notifications you control",
    points: [
      "Unified inbox across chat, docs, canvas and tasks",
      "Web push, native macOS APNs, in-app toasts",
      "Per-channel mode: all, mentions only, or muted",
      "Do-not-disturb with scheduled quiet hours",
    ],
  },
  {
    icon: "⚿",
    title: "Privacy & encryption",
    points: [
      "Opt-in end-to-end encrypted DMs with per-device keys",
      "Passkeys plus password login, argon2 hashes",
      "Notification previews you can strip back",
      "Streaming mode blurs the workspace while you share",
    ],
  },
  {
    icon: "⌂",
    title: "Yours, everywhere",
    points: [
      "One container plus Postgres; Redis for multi-replica",
      "AGPL-3.0, zero telemetry, zero tracking",
      "Web app plus native macOS, Windows and Linux builds",
      "Every integration is optional and inert until configured",
    ],
  },
];

/* FAQ — one array drives both the visible <details> list and FAQPage schema,
   so the markup can never drift from the answers Google and LLMs read. */
const faqs = [
  {
    q: "What is sharp?",
    a: "sharp is an open-source, self-hosted team communication platform — a Slack alternative you run yourself. One Rust binary serves chat, collaborative docs, whiteboards, kanban boards, a calendar, voice and video calls, a task tracker and an AI assistant, backed by Postgres. It is licensed AGPL-3.0.",
  },
  {
    q: "Is sharp free?",
    a: "Yes. sharp is AGPL-3.0 licensed with no paid tier, no seat count and no feature gates — the software costs $0. You pay only for the machine you run it on, which for a small team is a $5–10/month VPS plus whatever object storage you use for uploads.",
  },
  {
    q: "What do I need to self-host sharp?",
    a: "Docker Compose and a Postgres 16 database with the pgvector extension — the bundled compose file provides both. Everything else is optional: Redis for multi-replica fanout, S3 or MinIO for uploads, LiveKit for calls, an OpenAI-compatible API for the AI assistant, SMTP or Resend for email.",
  },
  {
    q: "How long does setup take?",
    a: "About five minutes. Clone the repo, copy .env.example to .env, set a JWT secret and a Postgres password, then run docker compose up -d. Migrations apply automatically on startup and the first account you register becomes the workspace owner.",
  },
  {
    q: "Does sharp send data to third parties?",
    a: "No. sharp ships zero telemetry and zero tracking, and calls no external service on its own. Every integration — Google Calendar, GitHub, GIFs, AI, push, email — stays completely inert until you set its environment variable, and the feature disappears from the UI.",
  },
  {
    q: "Does sharp support voice and video calls?",
    a: "Yes, through a self-hosted LiveKit SFU. Any channel, DM or standalone room becomes a call with webcam video and screen sharing including system audio. Limits are 25 participants, 16 cameras and 1 screen share per room. Picture-in-picture keeps a call floating while you work elsewhere.",
  },
  {
    q: "Are direct messages end-to-end encrypted?",
    a: "Optionally, yes. E2EE DMs use per-device X25519 and Ed25519 keys; the server performs zero cryptography and stores only opaque ciphertext plus public keys. It is a Keybase-style design without forward secrecy, and encrypted DMs are never indexed by the AI assistant.",
  },
  {
    q: "How does the AI assistant work?",
    a: "Sharpy is retrieval-augmented: workspace messages, docs and tasks are embedded into pgvector, and every retrieval re-checks channel membership and doc roles, so Sharpy can never surface content the asker cannot already read. It talks to any OpenAI-compatible endpoint, including a local model.",
  },
  {
    q: "Can I use sharp on desktop and mobile?",
    a: "sharp runs in any modern browser, and native Tauri 2 desktop builds are published for macOS, Windows and Linux — you point them at your own server URL and sign in through the system browser. A React Native mobile app is in development; the web app is responsive in the meantime.",
  },
  {
    q: "How does sharp handle tasks and issues?",
    a: "With a built-in Linear-lite tracker: projects carry a key, issues get identifiers like SHARP-123, and workflow states drive list and board views. Turn any chat message into a task, and GitHub sync moves state automatically — started when a branch or PR opens, completed on merge.",
  },
  {
    q: "Does sharp scale beyond one server?",
    a: "Yes. Set REDIS_URL and WebSocket events fan out through Redis pub/sub, so several replicas stay in sync behind a load balancer. Media never touches the app server: LiveKit carries call traffic with simulcast, dynacast and adaptive subscriptions.",
  },
  {
    q: "What does the AGPL-3.0 license mean for me?",
    a: "Run it, fork it, even sell hosting for it — you just have to publish your modifications under the same license. Internal use inside your own company carries no obligation beyond that, and there is no contributor license agreement or commercial edition behind a paywall.",
  },
];

const faqSchema = faqs.map((f) => ({
  "@type": "Question",
  name: f.q,
  acceptedAnswer: { "@type": "Answer", text: f.a },
}));

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: canonical,
      name: "sharp",
      description,
      inLanguage: "en",
      publisher: { "@id": `${siteUrl}/#author` },
    },
    {
      "@type": "Person",
      "@id": `${siteUrl}/#author`,
      name: "Davide Ghiotto",
      url: "https://davideghiotto.it",
      sameAs: [`https://github.com/${GITHUB_OWNER}`],
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${siteUrl}/#software`,
      name: "sharp",
      alternateName: "sharp — self-hosted Slack alternative",
      applicationCategory: "CommunicationApplication",
      applicationSubCategory: "Team chat, collaborative docs and video calls",
      operatingSystem: "Web, macOS, Windows, Linux, Docker",
      softwareVersion: version,
      dateModified: updated,
      url: siteUrl,
      downloadUrl: releases,
      installUrl: releases,
      codeRepository: repo,
      license: "https://www.gnu.org/licenses/agpl-3.0.html",
      isAccessibleForFree: true,
      description,
      image: ogImage,
      screenshot: ogImage,
      softwareRequirements: "Docker, PostgreSQL 16 with pgvector",
      programmingLanguage: ["Rust", "TypeScript"],
      author: { "@id": `${siteUrl}/#author` },
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
        availability: "https://schema.org/InStock",
      },
      featureList: features.map((f) => f.title),
    },
    {
      "@type": "HowTo",
      "@id": `${siteUrl}/#selfhost`,
      name: "How to self-host sharp",
      description:
        "Deploy sharp — an open-source Slack alternative — on your own server with Docker Compose in about five minutes.",
      totalTime: "PT5M",
      supply: [
        { "@type": "HowToSupply", name: "A Linux server or VPS with Docker" },
        { "@type": "HowToSupply", name: "A domain name pointed at that server" },
      ],
      step: [
        {
          "@type": "HowToStep",
          name: "Clone and configure",
          text: "Clone the repository, enter deploy/, copy .env.example to .env and set JWT_SECRET plus POSTGRES_PASSWORD.",
        },
        {
          "@type": "HowToStep",
          name: "Point DNS at your box",
          text: "Create an A record for your domain so the bundled Caddy service can issue TLS certificates automatically.",
        },
        {
          "@type": "HowToStep",
          name: "Start the stack",
          text: "Run docker compose up -d. Migrations apply on startup; open the domain and register the first account, which becomes the workspace owner.",
        },
      ],
    },
    {
      "@type": "FAQPage",
      "@id": `${siteUrl}/#faq`,
      mainEntity: faqSchema,
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <meta name="theme-color" content="#0e0e11" />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <meta name="author" content="Davide Ghiotto" />
    <meta name="generator" content={`sharp ${version}`} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="sharp" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="sharp — self-hosted team chat, docs, canvas, calls and tasks"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body>
    <!-- Animated gradient orbs -->
    <div class="gradient-orb orb-1" aria-hidden="true"></div>
    <div class="gradient-orb orb-2" aria-hidden="true"></div>
    <div class="gradient-orb orb-3" aria-hidden="true"></div>

    <!-- Floating particles -->
    <div class="particles" id="particles" aria-hidden="true"></div>

    <a class="skip-link" href="#what">Skip to content</a>

    <!-- ===== Nav ===== -->
    <nav class="nav" id="nav" aria-label="Primary">
      <div class="container nav-inner">
        <a class="brand" href="/">
          <span class="hash">#</span> sharp
        </a>
        <div class="nav-links">
          <a class="hide-sm" href="#features">Features</a>
          <a class="hide-sm" href="#sharpy">AI</a>
          <a class="hide-sm" href="#compare">Compare</a>
          <a class="hide-sm" href="#selfhost">Self-host</a>
          <a class="hide-sm" href="#faq">FAQ</a>
          <a class="hide-sm" href="#download">Download</a>
          <a class="gh" href={repo} rel="noopener">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.5v-1.7c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.8 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.6.8.5A11.5 11.5 0 0 0 23.5 12C23.5 5.7 18.3.5 12 .5Z"/></svg>
            GitHub
          </a>
        </div>
      </div>
    </nav>

    <!-- ===== Hero ===== -->
    <header class="hero" id="hero">
      <div class="hero-glow" id="heroGlow" aria-hidden="true"></div>
      <div class="container">
        <div class="mark reveal"><span>#</span></div>
        <div class="reveal" style="transition-delay:0.1s">
          <span class="pill"><span class="dot"></span> Open source · AGPL-3.0 · self-hosted</span>
        </div>
        <h1 class="headline reveal" style="transition-delay:0.2s">
          <span id="headlineText">The self-hosted Slack alternative.</span><span class="typing-cursor"></span>
        </h1>
        <p class="subline reveal" style="transition-delay:0.3s">
          Chat, collaborative docs, whiteboards, kanban boards, voice and video
          calls, a calendar, a Linear-lite task tracker and an AI assistant —
          one open-source container on your own server. Your data never leaves
          your infrastructure.
        </p>
        <div class="cta-row reveal" style="transition-delay:0.4s">
          <a id="downloadCta" class="btn btn-primary" href={releases} rel="noopener">
            Download for macOS
          </a>
          <a class="btn btn-ghost" href="#selfhost">Self-host in 5 minutes</a>
        </div>
        <p class="cta-note reveal" style="transition-delay:0.45s">No account. No telemetry. No SaaS lock-in.</p>

        <!-- ===== App mock with 3D tilt ===== -->
        <div class="mock-wrap reveal" style="transition-delay:0.5s">
          <div class="mock" id="mockTilt" role="img" aria-label="Screenshot-style mock of the sharp app showing the #general channel, a doc link and an open thread">
            <div class="mock-bar">
              <span class="tl"></span><span class="tl"></span><span class="tl"></span>
              <span class="title">sharp — #general</span>
            </div>
            <div class="mock-body">
              <aside class="mock-side">
                <div class="side-ws"><span class="hash">#</span> Acme Inc</div>
                <div class="side-label">Channels</div>
                <div class="side-item active"><span class="h">#</span> general</div>
                <div class="side-item"><span class="h">#</span> engineering <span class="badge">3</span></div>
                <div class="side-item"><span class="h">#</span> design</div>
                <div class="side-item"><span class="h">#</span> random</div>
                <div class="side-label">Pages</div>
                <div class="side-item"><span class="h">¶</span> Launch plan</div>
                <div class="side-item"><span class="h">◈</span> Architecture canvas</div>
                <div class="side-label">Direct messages</div>
                <div class="side-item">Jordan Lee <span class="pdot"></span></div>
                <div class="side-item">Priya Shah <span class="pdot"></span></div>
              </aside>
              <div class="mock-main">
                <div class="chan-head">
                  # general
                  <span class="topic">— company-wide announcements &amp; watercooler</span>
                </div>
                <div class="msgs">
                  <div class="msg">
                    <div class="avatar" style="background:#7c6cff">JL</div>
                    <div class="msg-body">
                      <div class="msg-head"><span class="name">Jordan Lee</span><span class="time">9:41 AM</span></div>
                      <div class="msg-text">morning team — shipping the v1 release today. self-hosted, one container, zero drama.</div>
                      <div class="reacts"><span class="react on">🚀 4</span><span class="react">🎉 2</span></div>
                    </div>
                  </div>
                  <div class="msg">
                    <div class="avatar" style="background:#3ddc84">PS</div>
                    <div class="msg-body">
                      <div class="msg-head"><span class="name">Priya Shah</span><span class="time">9:43 AM</span></div>
                      <div class="msg-text">love it. moved our whole workspace over the weekend, Postgres backup was painless.</div>
                      <div class="thread-link">↳ 3 replies · last today at 9:52 AM</div>
                    </div>
                  </div>
                  <div class="msg">
                    <div class="avatar" style="background:#ff8a5c">MK</div>
                    <div class="msg-body">
                      <div class="msg-head"><span class="name">Mika K</span><span class="time">9:50 AM</span></div>
                      <div class="msg-text">
                        search across every channel is instant now 🔍 @jordan
                        wrote it all up in <span class="docchip">¶ Launch plan</span>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="composer">Message #general — Enter to send, Shift+Enter for newline</div>
              </div>
              <aside class="mock-thread">
                <div class="thread-head">Thread <span>· 3 replies</span></div>
                <div class="msg" style="margin-bottom:14px">
                  <div class="avatar" style="width:30px;height:30px;font-size:12px;background:#3ddc84">PS</div>
                  <div class="msg-body">
                    <div class="msg-head"><span class="name">Priya Shah</span></div>
                    <div class="msg-text">which VPS did you land on?</div>
                  </div>
                </div>
                <div class="msg">
                  <div class="avatar" style="width:30px;height:30px;font-size:12px;background:#7c6cff">JL</div>
                  <div class="msg-body">
                    <div class="msg-head"><span class="name">Jordan Lee</span></div>
                    <div class="msg-text">a $6 box. Caddy does TLS, done.</div>
                  </div>
                </div>
              </aside>
            </div>
          </div>
        </div>
      </div>
    </header>

    <main>
      <!-- ===== Stats ===== -->
      <section id="stats" aria-label="sharp at a glance">
        <div class="container">
          <div class="stats-grid">
            <div class="stat-item reveal" style="transition-delay:0s">
              <div class="stat-number"><span class="count-up" data-target="1">0</span></div>
              <div class="stat-label">Container to deploy</div>
            </div>
            <div class="stat-item reveal" style="transition-delay:0.1s">
              <div class="stat-number"><span class="count-up" data-target="25">0</span></div>
              <div class="stat-label">People per call · 16 cameras</div>
            </div>
            <div class="stat-item reveal" style="transition-delay:0.2s">
              <div class="stat-number"><span class="count-up" data-target="0">0</span></div>
              <div class="stat-label">Telemetry · zero tracking</div>
            </div>
            <div class="stat-item reveal" style="transition-delay:0.3s">
              <div class="stat-number">$<span class="count-up" data-target="0">0</span></div>
              <div class="stat-label">License cost · AGPL-3.0</div>
            </div>
          </div>
        </div>
      </section>

      <!-- ===== What is sharp (definition block, built to be quoted) ===== -->
      <section id="what" class="what">
        <div class="container">
          <div class="what-layout">
            <div class="reveal">
              <div class="eyebrow">What is sharp?</div>
              <h2>An open-source Slack alternative you host yourself</h2>
              <p class="answer">
                sharp is an open-source, self-hosted team communication platform.
                A single Rust binary serves chat, collaborative docs, whiteboards,
                kanban boards, a calendar, LiveKit voice and video calls, a
                Linear-lite task tracker and an AI assistant — backed by Postgres,
                deployed as one container, licensed AGPL-3.0.
              </p>
              <p class="answer-sub">
                It is built for teams that want the whole Slack-plus-Notion-plus-Linear
                bundle without per-seat pricing, capped message history, or their
                conversations sitting in someone else's data centre.
              </p>
              <p class="freshness">
                Version {version} · last updated <time datetime={updated}>{updatedLabel}</time> ·
                <a href={docs} rel="noopener">architecture docs</a>
              </p>
            </div>

            <dl class="spec reveal" style="transition-delay:0.15s">
              <div><dt>License</dt><dd>AGPL-3.0 · no paid tier</dd></div>
              <div><dt>Server</dt><dd>Rust (axum) · one binary</dd></div>
              <div><dt>Database</dt><dd>Postgres 16 + pgvector</dd></div>
              <div><dt>Realtime</dt><dd>WebSocket · Redis pub/sub for replicas</dd></div>
              <div><dt>Calls</dt><dd>Self-hosted LiveKit SFU</dd></div>
              <div><dt>Clients</dt><dd>Web · macOS · Windows · Linux</dd></div>
              <div><dt>Storage</dt><dd>Your own S3 or MinIO bucket</dd></div>
              <div><dt>Telemetry</dt><dd>None</dd></div>
            </dl>
          </div>
        </div>
      </section>

      <!-- ===== Features ===== -->
      <section id="features">
        <div class="container">
          <div class="section-head reveal">
            <div class="eyebrow">Why sharp</div>
            <h2>One workspace. Chat, docs, canvas, calls, tasks &amp; AI.</h2>
            <p>Everything a team needs to talk, write, draw, meet and ship — and nothing that phones home.</p>
          </div>
          <div class="features stagger" id="featuresGrid">
            {features.map((f) => (
              <article class="card">
                <div class="icon" aria-hidden="true">{f.icon}</div>
                <h3>{f.title}</h3>
                <ul>
                  {f.points.map((p) => <li><span set:html={p} /></li>)}
                </ul>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- ===== Tasks (Linear-lite) ===== -->
      <section id="tasks" class="tasks-section">
        <div class="container">
          <div class="section-head reveal">
            <div class="eyebrow">Tasks</div>
            <h2>Linear-lite, built in.</h2>
            <p>
              A native issue tracker for the same workspace — projects, workflow states,
              list &amp; board views, chat bridging, and GitHub sync. No third-party SaaS.
            </p>
          </div>

          <div class="tasks-layout">
            <div class="tasks-copy reveal-left">
              <ul class="tasks-points">
                <li>
                  <strong>Projects &amp; identifiers</strong>
